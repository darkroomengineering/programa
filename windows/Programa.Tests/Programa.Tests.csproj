<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="..\Programa\Programa.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(ProgramaNativeDirectory)' != ''">
    <Content Include="$(ProgramaNativeDirectory)\programa_core.dll" Link="programa_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ProgramaNativeDirectory)\programa_terminal.dll" Link="programa_terminal.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
