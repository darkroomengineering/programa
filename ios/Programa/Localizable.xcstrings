{
  "sourceLanguage" : "en",
  "strings" : {
    "common.cancel" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャンセル" } }
      }
    },
    "common.retry" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Try Again" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再試行" } }
      }
    },
    "devices.forget" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Forget Mac" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Macの登録を解除" } }
      }
    },
    "devices.forgetMessage" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tasks stay on the Mac. You can pair with it again any time." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "タスクはMacに残ります。いつでも再ペアリングできます。" } }
      }
    },
    "devices.forgetTitle" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Forget this Mac?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMacの登録を解除しますか？" } }
      }
    },
    "error.busy" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Mac is busy. Try again in a moment." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Macが処理中です。しばらくしてからお試しください。" } }
      }
    },
    "error.host" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Programa is unavailable on your Mac." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "MacのProgramaを利用できません。" } }
      }
    },
    "error.keychain" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Programa could not access its credentials. Unlock your iPhone and try again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Programaの認証情報にアクセスできませんでした。iPhoneのロックを解除して再試行してください。" } }
      }
    },
    "error.missing" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This job or repository is unavailable on your Mac." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このタスクまたはリポジトリはMacで利用できません。" } }
      }
    },
    "error.pairCode" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan or paste the full pairing code from your Mac." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Macに表示されたペアリングコード全体をスキャンするか、貼り付けてください。" } }
      }
    },
    "error.pairExpired" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Mac refused this pairing code. Generate a new code and try again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Macがペアリングコードを拒否しました。新しいコードを発行して再試行してください。" } }
      }
    },
    "error.reply" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Programa received an unexpected reply. Check that both apps are up to date." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Programaが予期しない応答を受信しました。両方のアプリが最新か確認してください。" } }
      }
    },
    "error.request" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Mac could not accept this request." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Macがこのリクエストを受け付けられませんでした。" } }
      }
    },
    "error.revoked" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This iPhone no longer has access. Pair it again on your Mac." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このiPhoneのアクセス権がありません。Macで再ペアリングしてください。" } }
      }
    },
    "error.storage" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Mac could not read or save this job." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Macでこのタスクを読み込むか保存できませんでした。" } }
      }
    },
    "error.unreachable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not reach your Mac. Check that it is awake and Programa is running." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Macに接続できませんでした。Macがスリープしておらず、Programaが起動していることを確認してください。" } }
      }
    },
    "inbox.empty.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Start a task to work on a repository from your Mac." } },
