#!/usr/bin/env bash
# programa claude wrapper - injects hooks and session tracking
#
# When running inside a programa terminal (PROGRAMA_SURFACE_ID is set), this wrapper
# intercepts `claude` invocations to inject --session-id and --settings flags
# so that Claude Code hooks fire back into programa for notifications/status,
# plus the bundled programa-mcp server and a short system prompt pointing the
# session at the programa skill. Outside programa, it passes through to the
# real claude binary unchanged.

# Find the real claude binary, skipping our own directory.
find_real_claude() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        [[ -x "$d/claude" ]] && printf '%s' "$d/claude" && return 0
    done
    return 1
}

# Return 0 only when PROGRAMA_SOCKET_PATH points to a live programa socket.
programa_socket_available() {
    local socket="${PROGRAMA_SOCKET_PATH:-}"
    [[ -n "$socket" && -S "$socket" ]] || return 1

    local self_dir programa_bin
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    programa_bin="$self_dir/programa"
    [[ -x "$programa_bin" ]] || programa_bin="$(command -v programa || true)"
    [[ -n "$programa_bin" ]] || return 1

    # Keep stale/hung socket checks bounded so claude startup does not block
    # behind the CLI default timeout (15s).
    PROGRAMA_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
        "$programa_bin" --socket "$socket" ping >/dev/null 2>&1
}

resolve_hook_programa_bin() {
    local self_dir bundled_cli
    bundled_cli="${PROGRAMA_BUNDLED_CLI_PATH:-}"
    if [[ -n "$bundled_cli" && -x "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    self_dir="$(cd "$(dirname "$0")" && pwd)"
    bundled_cli="$self_dir/programa"
    if [[ -x "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    bundled_cli="$(command -v programa || true)"
    if [[ -n "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    printf '%s' "programa"
}

# Pass through if not in a programa terminal, hooks are disabled, or the programa
# socket is unavailable (stale env / app not running).
IN_PROGRAMA=0
if [[ -n "$PROGRAMA_SURFACE_ID" ]]; then
    IN_PROGRAMA=1
fi

if [[ "$IN_PROGRAMA" == "0" || "$PROGRAMA_CLAUDE_HOOKS_DISABLED" == "1" ]] || ! programa_socket_available; then
    # In programa-launched shells, preserve old behavior and always clear nested
    # Claude session markers, even when we must pass through due to stale socket.
    if [[ "$IN_PROGRAMA" == "1" ]]; then
        unset CLAUDECODE
    fi
    REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }
    exec "$REAL_CLAUDE" "$@"
fi

# Find real claude.
REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }

# The restore module ships in the app bundle next to this wrapper, so nothing
# another user can write is ever loaded through --require.
node_options_restore_module() {
    local self_dir guard_path
    self_dir="$(cd "$(dirname "$0")" && pwd)" || return 1
    guard_path="$self_dir/restore-node-options.cjs"
    [[ -f "$guard_path" ]] || return 1
    printf '%s' "$guard_path"
}

# Node splits NODE_OPTIONS on spaces outside double quotes and honors backslash
# escapes inside them, so the bundle path (which may contain spaces) is quoted.
quote_node_option_value() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    printf '"%s"' "$value"
}

merge_node_options() {
    local guard_path="$1"
    local require_flag="--require=$(quote_node_option_value "$guard_path")"
    local memory_flag="--max-old-space-size=4096"
    local existing="${NODE_OPTIONS:-}"
    local -a filtered=()
    local -a tokens=()
    local token
    local skip_next=0

    if [[ -z "$guard_path" ]]; then
        printf '%s' "$existing"
        return 0
    fi

    read -r -a tokens <<<"$existing"
    for token in "${tokens[@]}"; do
        if (( skip_next )); then
            skip_next=0
            continue
        fi
        if [[ "$token" == "--max-old-space-size" ]]; then
            skip_next=1
            continue
        fi
        if [[ "$token" == --max-old-space-size=* ]]; then
            continue
        fi
        filtered+=("$token")
    done

    if (( ${#filtered[@]} == 0 )); then
        printf '%s %s' "$require_flag" "$memory_flag"
        return 0
    fi
    printf '%s %s' "$require_flag" "$memory_flag"
    printf ' %s' "${filtered[@]}"
}

# Pass through subcommands that don't support session/hook flags.
case "${1:-}" in
    mcp|config|api-key|rc|remote-control) exec "$REAL_CLAUDE" "$@" ;;
esac

# Unset CLAUDECODE to avoid "nested session" detection — programa terminals are
# independent sessions even when the parent shell was launched from Claude Code.
unset CLAUDECODE

# Never inject a flag the user already passed: a second --session-id conflicts,
# and an explicit MCP or system-prompt choice is the user's to make.
SKIP_SESSION_ID=false
SKIP_MCP_CONFIG=false
SKIP_SYSTEM_PROMPT=false
for arg in "$@"; do
    case "$arg" in
        --resume|--resume=*|-r|--session-id|--session-id=*|--continue|-c)
            SKIP_SESSION_ID=true
            ;;
        --mcp-config|--mcp-config=*|--strict-mcp-config)
            SKIP_MCP_CONFIG=true
            ;;
        --system-prompt|--system-prompt=*|--system-prompt-file|--system-prompt-file=*|--append-system-prompt|--append-system-prompt=*|--append-system-prompt-file|--append-system-prompt-file=*)
            SKIP_SYSTEM_PROMPT=true
            ;;
    esac
done

# programa-mcp ships next to the bundled programa CLI and this wrapper.
resolve_programa_mcp_bin() {
    local candidate dir
    for candidate in "${PROGRAMA_BUNDLED_CLI_PATH:-}" "$0"; do
        [[ -n "$candidate" ]] || continue
        dir="$(cd "$(dirname "$candidate")" 2>/dev/null && pwd)" || continue
        if [[ -x "$dir/programa-mcp" ]]; then
            printf '%s' "$dir/programa-mcp"
            return 0
        fi
    done
    return 1
}

json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    printf '%s' "$value"
}

# Export the wrapper's PID. Because we exec claude below, this PID becomes
# the actual claude process PID, which hooks use for stale-session detection.
export PROGRAMA_CLAUDE_PID=$$
export PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN="$(resolve_hook_programa_bin)"
if GUARD_PATH="$(node_options_restore_module)"; then
    if [[ ${NODE_OPTIONS+x} ]]; then
        export PROGRAMA_ORIGINAL_NODE_OPTIONS_PRESENT=1
        export PROGRAMA_ORIGINAL_NODE_OPTIONS="$NODE_OPTIONS"
    else
        export PROGRAMA_ORIGINAL_NODE_OPTIONS_PRESENT=0
        unset PROGRAMA_ORIGINAL_NODE_OPTIONS
    fi
    export NODE_OPTIONS="$(merge_node_options "$GUARD_PATH")"
fi

# Build hooks settings JSON.
# Claude Code merges --settings additively with the user's own settings.json.
# - SessionStart/Stop/Notification: existing lifecycle hooks
# - SessionEnd: cleanup when Claude exits (covers Ctrl+C where Stop doesn't fire)
# - UserPromptSubmit: clears "Needs input" and sets "Running" on new prompt
# - PreToolUse: clears "Needs input" when Claude resumes after permission grant (async to avoid latency)
# - SubagentStart/SubagentStop: adds and finishes helpers in Agent Overview
HOOKS_JSON='{"hooks":{"SessionStart":[{"matcher":"","hooks":[{"type":"command","command":"\"${PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN:-programa}\" claude-hook session-start","timeout":10}]}],"Stop":[{"matcher":"","hooks":[{"type":"command","command":"\"${PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN:-programa}\" claude-hook stop","timeout":10}]}],"SessionEnd":[{"matcher":"","hooks":[{"type":"command","command":"\"${PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN:-programa}\" claude-hook session-end","timeout":1}]}],"Notification":[{"matcher":"","hooks":[{"type":"command","command":"\"${PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN:-programa}\" claude-hook notification","timeout":10}]}],"UserPromptSubmit":[{"matcher":"","hooks":[{"type":"command","command":"\"${PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN:-programa}\" claude-hook prompt-submit","timeout":10}]}],"PreToolUse":[{"matcher":"","hooks":[{"type":"command","command":"\"${PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN:-programa}\" claude-hook pre-tool-use","timeout":5,"async":true}]}],"SubagentStart":[{"matcher":"","hooks":[{"type":"command","command":"\"${PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN:-programa}\" claude-hook subagent-start","timeout":5}]}],"SubagentStop":[{"matcher":"","hooks":[{"type":"command","command":"\"${PROGRAMA_CLAUDE_HOOK_PROGRAMA_BIN:-programa}\" claude-hook subagent-stop","timeout":5}]}]}}'

# Detect which optional flags the resolved claude binary supports. Some
# environments (e.g. nvm not yet initialized in a fresh tab) may resolve to an
# older binary that rejects them (#1818). Cache the result per binary
# path+mtime so the --help subprocess only runs once per binary update.
_claude_real_mtime="$(stat -f '%m' "$REAL_CLAUDE" 2>/dev/null || stat -c '%Y' "$REAL_CLAUDE" 2>/dev/null || echo 0)"
_claude_cache_key="${REAL_CLAUDE}:${_claude_real_mtime}"
if [[ "${_PROGRAMA_CLAUDE_FLAGS_CACHE_KEY:-}" == "$_claude_cache_key" ]]; then
    _claude_flags="$_PROGRAMA_CLAUDE_FLAGS_CACHE_VAL"
else
    _claude_help="$("$REAL_CLAUDE" --help 2>&1)"
    _claude_flags=" "
    for _flag in session-id mcp-config append-system-prompt; do
        if grep -Eq -- "^[[:space:]]*(-[[:alpha:]], )?--${_flag}[[:space:]]" <<<"$_claude_help"; then
            _claude_flags+="${_flag} "
        fi
    done
    export _PROGRAMA_CLAUDE_FLAGS_CACHE_KEY="$_claude_cache_key"
    export _PROGRAMA_CLAUDE_FLAGS_CACHE_VAL="$_claude_flags"
fi

INJECTED_ARGS=()
if [[ "$SKIP_SESSION_ID" == false && "$_claude_flags" == *" session-id "* ]]; then
    INJECTED_ARGS+=(--session-id "$(uuidgen | tr '[:upper:]' '[:lower:]')")
fi
INJECTED_ARGS+=(--settings "$HOOKS_JSON")

# A server passed through --mcp-config replaces a same-named one from the
# user's own config for this session only, so "programa" always targets the
# app this pane belongs to. The equals form matters: --mcp-config is variadic
# and the space form would swallow a following positional prompt.
if [[ "$SKIP_MCP_CONFIG" == false && "$_claude_flags" == *" mcp-config "* ]] \
    && PROGRAMA_MCP_BIN="$(resolve_programa_mcp_bin)"; then
    INJECTED_ARGS+=("--mcp-config={\"mcpServers\":{\"programa\":{\"command\":\"$(json_escape "$PROGRAMA_MCP_BIN")\"}}}")
fi

if [[ "$SKIP_SYSTEM_PROMPT" == false && "$_claude_flags" == *" append-system-prompt "* ]]; then
    INJECTED_ARGS+=(--append-system-prompt "You are running inside Programa, a terminal built for running coding agents in parallel.
Before splitting work, running long jobs, or reviewing a diff, read the programa skill (or run \`programa help\`).
Prefer what it describes: \`programa worktree create\` or agent_spawn with needs_isolation for conflicting edits, \`programa race\` for competing attempts, \`programa review\` for diffs, and \`programa wait-surface\` for long jobs.
For long-running or parallel work, split a pane (surface_split) or start a sibling agent (agent_spawn) so the user can watch it, and say which pane. For coordinated parallel agents, suggest the user restart with \`programa claude-teams\`.
Do not move the user's focus unless they ask.")
fi

exec "$REAL_CLAUDE" "${INJECTED_ARGS[@]}" "$@"
