    "settings.customCommands.trustedDirectories.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands from programa.json in these directories run without confirmation. One path per line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのディレクトリ内のprograma.jsonのコマンドは、確認なしで実行されます。1行に1つのパスを記述します。"
          }
        }
      }
    },
    "settings.customCommands.trustedDirectories.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a programa.json in your project root to define custom commands. Trust a directory from the confirmation dialog, or add paths here. For git repos, trusting the root covers all subdirectories."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトのルートにprograma.jsonを配置すると、カスタムコマンドを定義できます。確認ダイアログからディレクトリを信頼するか、ここにパスを追加してください。Gitリポジトリの場合、ルートを信頼するとすべてのサブディレクトリに適用されます。"
          }
        }
      }
    },
