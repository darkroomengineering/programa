      }
    },
    "settings.app.persistScrollback.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Some older sessions may still write terminal output to disk." } },
        "ja": { "stringUnit": { "state": "translated", "value": "一部の古いセッションでは、ターミナル出力が引き続きディスクに書き込まれる可能性があります。" } }
      }
    },
    "settings.app.persistScrollback.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal scrollback is not written to disk."
          }
