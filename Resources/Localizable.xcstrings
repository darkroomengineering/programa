      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal scrollback is saved and restored on next launch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
