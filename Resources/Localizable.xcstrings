{
  "sourceLanguage": "en",
  "strings": {
    "settings.notifications.permission.subtitle.notDetermined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop notifications are not enabled yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ通知はまだ有効になっていません。"
          }
        }
      }
    },
    "settings.notifications.permission.subtitle.authorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop notifications are enabled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ通知は有効です。"
          }
        }
      }
    },
    "settings.notifications.permission.subtitle.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop notifications are disabled in System Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ通知はシステム設定で無効になっています。"
          }
        }
