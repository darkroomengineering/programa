    },
    "settings.notifications.permission.subtitle.provisional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop notifications are enabled with quiet delivery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ通知は静かに配信される設定で有効になっています。"
          }
        }
      }
    },
    "settings.notifications.permission.subtitle.ephemeral": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
