    "settings.app.persistScrollback.incomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Scrollback privacy could not be fully applied. Retry to finish protecting existing sessions." } },
        "ja": { "stringUnit": { "state": "translated", "value": "スクロールバックのプライバシー設定を完全に適用できませんでした。再試行して既存のセッションを保護してください。" } }
