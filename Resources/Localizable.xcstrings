    "review.comment.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment could not be added. Use a valid line range, a file path up to 16 KB, and nonempty text up to 64 KB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コメントを追加できませんでした。有効な行範囲、16 KB 以下のファイルパス、64 KB 以下の空でない本文を使用してください。"
          }
        }
      }
    },
    "review.comment.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This review already has 2,048 comments. Send or remove comments before adding more."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレビューにはすでに 2,048 件のコメントがあります。追加する前にコメントを送信または削除してください。"
