# Working plan documents. These are scratch thinking, not deliverables, and they
# accumulate fast enough to bury real docs in review diffs.
plans/

# Agent-written recaps, written into the repo root by `programa recap`. The CLI
# also drops a self-ignoring .gitignore inside the directory on first use; this
# covers repos where no recap command has run yet.
.programa/
